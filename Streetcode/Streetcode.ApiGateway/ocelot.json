      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7163
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/email/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "PATCH", "DELETE" ],
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7163
        }
      ]
    }
  ],
